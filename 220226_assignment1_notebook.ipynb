      "source": [
        "from tensorflow.keras.layers import Dense, Activation, Dropout, Flatten, Conv2D, MaxPooling2D, BatchNormalization\n",
        "from tensorflow.keras.models import Sequential\n",
        "\n",
        "VGG16_version1 = Sequential(name=\"VGG16_version1\")\n",
        "\n",
        "# Block 1\n",
        "VGG16_version1.add(Conv2D(filters=64, input_shape=(28,28,1), kernel_size=(3,3), strides=(1,1), padding='same', name='Block_1_Conv1')) # padding=\"same\" means input and output have the same spatial dimension.\n",
        "VGG16_version1.add(Activation('relu')) # Add RELU activation function\n",
        "VGG16_version1.add(Conv2D(filters=64, kernel_size=(3,3), strides=(1,1), padding='same', name='Block_1_Conv2')) # padding=\"same\" means input and output have the same spatial dimension.\n",
        "VGG16_version1.add(Activation('relu')) # Add RELU activation function\n",
        "VGG16_version1.add(MaxPooling2D(pool_size=(3,3), strides=(2,2), padding='same', name='Block_1_MaxPool')) # Overlapping MaxPooling since the pooling kernel (3x3) is larger than the pooing stride (2x2).\n",
        "\n",
        "# Block 2\n",
        "VGG16_version1.add(Conv2D(filters=128, kernel_size=(3, 3), strides=(1, 1), padding='same', name='Block_2_Conv1'))\n",
        "VGG16_version1.add(Activation('relu'))\n",
        "VGG16_version1.add(Conv2D(filters=128, kernel_size=(3, 3), strides=(1, 1), padding='same', name='Block_2_Conv2'))\n",
        "VGG16_version1.add(Activation('relu'))\n",
        "VGG16_version1.add(MaxPooling2D(pool_size=(3,3), strides=(2, 2), padding='same', name='Block_2_MaxPool'))\n",
        "\n",
        "# Block 3\n",
        "VGG16_version1.add(Conv2D(filters=256, kernel_size=(3, 3), strides=(1, 1), padding='same', name='Block_3_Conv1'))\n",
        "VGG16_version1.add(Activation('relu'))\n",
        "VGG16_version1.add(Conv2D(filters=256, kernel_size=(3, 3), strides=(1, 1), padding='same', name='Block_3_Conv2'))\n",
        "VGG16_version1.add(Activation('relu'))\n",
        "VGG16_version1.add(Conv2D(filters=256, kernel_size=(3, 3), strides=(1, 1), padding='same', name='Block_3_Conv3'))\n",
        "VGG16_version1.add(Activation('relu'))\n",
        "VGG16_version1.add(MaxPooling2D(pool_size=(3, 3), strides=(2, 2), padding='same', name='Block_3_MaxPool'))\n",
        "\n",
        "# Block 4\n",
        "VGG16_version1.add(Conv2D(filters=512, kernel_size=(3, 3), strides=(1, 1), padding='same', name='Block_4_Conv1'))\n",
        "VGG16_version1.add(Activation('relu'))\n",
        "VGG16_version1.add(Conv2D(filters=512, kernel_size=(3, 3), strides=(1, 1), padding='same', name='Block_4_Conv2'))\n",
        "VGG16_version1.add(Activation('relu'))\n",
        "VGG16_version1.add(Conv2D(filters=512, kernel_size=(3, 3), strides=(1, 1), padding='same', name='Block_4_Conv3'))\n",
        "VGG16_version1.add(Activation('relu'))\n",
        "VGG16_version1.add(MaxPooling2D(pool_size=(3, 3), strides=(2, 2), padding='same', name='Block_4_MaxPool'))\n",
        "\n",
        "# Block 5\n",
        "VGG16_version1.add(Conv2D(filters=512, kernel_size=(3, 3), strides=(1, 1), padding='same', name='Block_5_Conv1'))\n",
        "VGG16_version1.add(Activation('relu'))\n",
        "VGG16_version1.add(Conv2D(filters=512, kernel_size=(3, 3), strides=(1, 1), padding='same', name='Block_5_Conv2'))\n",
        "VGG16_version1.add(Activation('relu'))\n",
        "VGG16_version1.add(Conv2D(filters=512, kernel_size=(3, 3), strides=(1, 1), padding='same', name='Block_5_Conv3'))\n",
        "VGG16_version1.add(Activation('relu'))\n",
        "VGG16_version1.add(MaxPooling2D(pool_size=(3,3), strides=(2, 2), padding='same', name='Block_5_MaxPool'))\n",
        "\n",
        "# Flatten the feature maps\n",
        "VGG16_version1.add(Flatten())\n",
        "\n",
        "# Fully connected layers\n",
        "VGG16_version1.add(Dense(4096, name='FC1'))\n",
        "VGG16_version1.add(Activation('relu'))\n",
        "VGG16_version1.add(Dropout(rate=0.4))\n",
        "\n",
        "VGG16_version1.add(Dense(4096, name='FC2'))\n",
        "VGG16_version1.add(Activation('relu'))\n",
        "VGG16_version1.add(BatchNormalization())\n",
        "VGG16_version1.add(Dropout(rate=0.4))\n",
        "\n",
        "VGG16_version1.add(Dense(1000, name='FC3'))\n",
        "VGG16_version1.add(Activation('relu'))\n",
        "VGG16_version1.add(BatchNormalization())\n",
        "VGG16_version1.add(Dropout(rate=0.4))\n",
        "\n",
        "# Fully connected (FC) layer 3\n",
        "VGG16_version1.add(Dense(10)) # Number of output classes\n",
        "VGG16_version1.add(Activation('softmax'))\n",
        "\n",
        "VGG16_version1.summary()"
      ]
    },
    {
      "cell_type": "code",
      "source": [
