      "cell_type": "markdown",
      "source": [
        "#**1.5 (2 points)** Enhance the VGG16 model by adding supplementary layers of your choice to boost the performance of VGG16_version1, now designated as VGG16-version2."
      ],
      "metadata": {
        "id": "bcT6JhLGutXh"
      }
    },
    {
      "cell_type": "markdown",
      "source": [
        "Adding a new block with 2 Conv2D and 1 Max Pooling."
      ],
      "metadata": {
        "id": "cgarJI8WvokZ"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "VGG16_version2 = Sequential(name=\"VGG16_version2\")\n",
        "\n",
        "# Block 1\n",
        "VGG16_version2.add(Conv2D(filters=64, input_shape=(28,28,1), kernel_size=(3,3), strides=(1,1), padding='same', name='Block_1_Conv1')) # padding=\"same\" means input and output have the same spatial dimension.\n",
        "VGG16_version2.add(Activation('relu')) # Add RELU activation function\n",
        "VGG16_version2.add(Conv2D(filters=64, kernel_size=(3,3), strides=(1,1), padding='same', name='Block_1_Conv2')) # padding=\"same\" means input and output have the same spatial dimension.\n",
        "VGG16_version2.add(Activation('relu')) # Add RELU activation function\n",
        "VGG16_version2.add(MaxPooling2D(pool_size=(3,3), strides=(2,2), padding='same', name='Block_1_MaxPool')) # Overlapping MaxPooling since the pooling kernel (3x3) is larger than the pooing stride (2x2).\n",
        "\n",
        "# Block 2\n",
        "VGG16_version2.add(Conv2D(filters=128, kernel_size=(3, 3), strides=(1, 1), padding='same', name='Block_2_Conv1'))\n",
        "VGG16_version2.add(Activation('relu'))\n",
        "VGG16_version2.add(Conv2D(filters=128, kernel_size=(3, 3), strides=(1, 1), padding='same', name='Block_2_Conv2'))\n",
        "VGG16_version2.add(Activation('relu'))\n",
        "VGG16_version2.add(MaxPooling2D(pool_size=(3,3), strides=(2, 2), padding='same', name='Block_2_MaxPool'))\n",
        "\n",
        "# Block 3\n",
        "VGG16_version2.add(Conv2D(filters=256, kernel_size=(3, 3), strides=(1, 1), padding='same', name='Block_3_Conv1'))\n",
        "VGG16_version2.add(Activation('relu'))\n",
        "VGG16_version2.add(Conv2D(filters=256, kernel_size=(3, 3), strides=(1, 1), padding='same', name='Block_3_Conv2'))\n",
        "VGG16_version2.add(Activation('relu'))\n",
        "VGG16_version2.add(Conv2D(filters=256, kernel_size=(3, 3), strides=(1, 1), padding='same', name='Block_3_Conv3'))\n",
        "VGG16_version2.add(Activation('relu'))\n",
        "VGG16_version2.add(MaxPooling2D(pool_size=(3, 3), strides=(2, 2), padding='same', name='Block_3_MaxPool'))\n",
        "\n",
        "# Block 4\n",
        "VGG16_version2.add(Conv2D(filters=512, kernel_size=(3, 3), strides=(1, 1), padding='same', name='Block_4_Conv1'))\n",
        "VGG16_version2.add(Activation('relu'))\n",
        "VGG16_version2.add(Conv2D(filters=512, kernel_size=(3, 3), strides=(1, 1), padding='same', name='Block_4_Conv2'))\n",
        "VGG16_version2.add(Activation('relu'))\n",
        "VGG16_version2.add(Conv2D(filters=512, kernel_size=(3, 3), strides=(1, 1), padding='same', name='Block_4_Conv3'))\n",
        "VGG16_version2.add(Activation('relu'))\n",
        "VGG16_version2.add(MaxPooling2D(pool_size=(3, 3), strides=(2, 2), padding='same', name='Block_4_MaxPool'))\n",
        "\n",
        "# Block 5\n",
        "VGG16_version2.add(Conv2D(filters=512, kernel_size=(3, 3), strides=(1, 1), padding='same', name='Block_5_Conv1'))\n",
        "VGG16_version2.add(Activation('relu'))\n",
        "VGG16_version2.add(Conv2D(filters=512, kernel_size=(3, 3), strides=(1, 1), padding='same', name='Block_5_Conv2'))\n",
        "VGG16_version2.add(Activation('relu'))\n",
        "VGG16_version2.add(Conv2D(filters=512, kernel_size=(3, 3), strides=(1, 1), padding='same', name='Block_5_Conv3'))\n",
        "VGG16_version2.add(Activation('relu'))\n",
        "VGG16_version2.add(MaxPooling2D(pool_size=(3,3), strides=(2, 2), padding='same', name='Block_5_MaxPool'))\n",
        "\n",
        "# Additional Block\n",
        "VGG16_version2.add(Conv2D(filters=64, input_shape=(28,28,1), kernel_size=(3,3), strides=(1,1), padding='same', name='Block_add_Conv1')) # padding=\"same\" means input and output have the same spatial dimension.\n",
        "VGG16_version2.add(Activation('relu')) # Add RELU activation function\n",
